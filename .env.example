# URL-ul public canonic (fără slash final). Opțional: fără el nu se emit
# canonical, sitemap cu URL-uri absolute sau metadataBase.
# NEXT_PUBLIC_SITE_URL=https://aproape24.ro

# Activează /dev/design-system într-un build de producție (doar pentru teste locale/E2E).
# Nu seta niciodată în producție.
# ENABLE_DEV_ROUTES=1
